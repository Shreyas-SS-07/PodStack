[Unit]
Description=PodStack Web Service – Rootless Podman Container
# Require the network to be up before starting
After=network-online.target
Wants=network-online.target
# Documentation links (shown by: systemctl status podstack-web)
Documentation=https://github.com/youruser/podstack
PartOf=podstack.target

[Service]
# ─── Service type ────────────────────────────────────────────────────────────
# "forking" is used when the process daemonises itself.
# Podman auto-generate prefers "notify" for newer Podman versions.
Type=notify
NotifyAccess=all

# ─── Environment ─────────────────────────────────────────────────────────────
Environment=PODMAN_SYSTEMD_UNIT=%n
# XDG_RUNTIME_DIR is required for rootless Podman to find the user socket
Environment=XDG_RUNTIME_DIR=/run/user/%U

# ─── Start ───────────────────────────────────────────────────────────────────
ExecStartPre=/bin/rm -f %t/podstack-web.pid %t/podstack-web.ctr-id

ExecStart=/usr/bin/podman run \
    --cidfile=%t/podstack-web.ctr-id \
    --cgroups=no-conmon \
    --sdnotify=conmon \
    --replace \
    --detach \
    --name=podstack-web \
    --label=io.containers.autoupdate=registry \
    --publish=8080:8080 \
    --volume=%h/podstack-data:/data:Z \
    --memory=256m \
    --cpus=0.5 \
    localhost/podstack-web:latest

# ─── Reload ──────────────────────────────────────────────────────────────────
ExecReload=/usr/bin/podman kill --signal=HUP podstack-web

# ─── Stop ────────────────────────────────────────────────────────────────────
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/podstack-web.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/podstack-web.ctr-id

# ─── Reliability ─────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s
# Allow up to 5 restarts within 30 seconds before giving up
StartLimitInterval=30s
StartLimitBurst=5

# ─── Timeouts ────────────────────────────────────────────────────────────────
TimeoutStartSec=120
TimeoutStopSec=30

# PID file (used by systemd to track the Podman conmon process)
PIDFile=%t/podstack-web.pid

[Install]
# WantedBy=default.target means this unit is started automatically when
# the user's systemd instance reaches its "default" target — which happens
# at login (or at boot if lingering is enabled).
WantedBy=default.target
