[Unit]
Description=PodStack Backend API Service – Rootless Podman Container (Service 2/3)
After=network-online.target
Wants=network-online.target
PartOf=podstack.target
Documentation=https://github.com/youruser/podstack

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=XDG_RUNTIME_DIR=/run/user/%U

ExecStartPre=/bin/rm -f %t/podstack-api.pid %t/podstack-api.ctr-id

ExecStart=/usr/bin/podman run \
    --cidfile=%t/podstack-api.ctr-id \
    --cgroups=no-conmon \
    --sdnotify=conmon \
    --replace \
    --detach \
    --name=podstack-api \
    --publish=8081:8081 \
    --volume=%h/podstack-api-data:/data:Z \
    --memory=256m \
    --cpus=0.5 \
    localhost/podstack-web:latest \
    python3 /app/api.py

ExecReload=/usr/bin/podman kill --signal=HUP podstack-api
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/podstack-api.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile=%t/podstack-api.ctr-id

Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30
PIDFile=%t/podstack-api.pid

[Install]
WantedBy=default.target podstack.target
