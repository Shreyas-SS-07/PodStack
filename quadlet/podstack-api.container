[Unit]
Description=PodStack Backend API – Quadlet Container (Modern RHEL 9.2+)
Documentation=https://github.com/youruser/podstack

[Container]
Image=localhost/podstack-web:latest
ContainerName=podstack-api
Exec=python3 /app/api.py
PublishPort=8081:8081
Volume=%h/podstack-api-data:/data:Z
Memory=256m
CPUQuota=50%
CPUShares=512

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
